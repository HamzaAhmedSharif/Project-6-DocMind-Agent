TAVILY_API_KEY=your_key_here
# LLM backend: "ollama" (local) or "hosted" (any OpenAI-compatible API, e.g. Groq's free tier)
LLM_PROVIDER=hosted
HOSTED_BASE_URL=https://api.groq.com/openai/v1
HOSTED_API_KEY=your_key_here
HOSTED_MODEL=your_model_id_here
HOSTED_RPM=20
# Provider tokens-per-minute limit (0 = no token pacing)
HOSTED_TPM=8000
# Optional provider-specific request fields as JSON (e.g. {"reasoning_effort":"low"} for gpt-oss models); {} for none
HOSTED_EXTRA_BODY={}
